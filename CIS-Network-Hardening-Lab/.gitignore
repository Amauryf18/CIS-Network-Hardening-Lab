# Secretos y variables de entorno
.env
*.key
*.pem
secrets/
credentials*

# Entorno Python
.venv/
venv/
__pycache__/
*.py[cod]

# Resultados generados (mantener directorios con .gitkeep)
reports/*
!reports/**/.gitkeep
backups/*
!backups/**/.gitkeep
logs/*
!logs/**/.gitkeep

# Archivos temporales
*.tmp
*.swp
.DS_Store
